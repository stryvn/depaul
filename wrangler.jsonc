{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "depaul-school",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "depaul-db",
      "database_id": "e2ddebbd-a499-430e-b1d9-bc7b47a21cf0"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "depaul-media"
    }
  ]
}
