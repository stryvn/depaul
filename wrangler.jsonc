{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "depaul-school",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "depaul-db",
      "database_id": "e2ddebbd-a499-430e-b1d9-bc7b47a21cf0",
      "migrations_dir": "cloudflare-migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "depaul-media"
    }
  ],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "DEPAUL_CLOUDFLARE": "1"
  }
}
